#!/usr/bin/env bash
## Description: Full verification pass -- every gate is blocking
## Usage: check [--integration]
## Example: "ddev check" / "ddev check --integration"
set -uo pipefail
cd /var/www/html

# --integration additionally runs the #[ignore]d qf_api tests, which need a
# Quantframe API server on http://localhost:6969. See docs/FORK.md.
INTEGRATION=0
[ "${1:-}" = "--integration" ] && INTEGRATION=1

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }
fail=0
run() { "$@" || fail=1; }

step "eslint"
# Exits non-zero on errors only. Warnings are expected and counted, not fatal:
# ~600 no-explicit-any and ~455 rules-of-hooks are tracked debt, see docs/FORK.md.
run pnpm lint

step "tsc + vite build (frontend)"
run pnpm build

step "cargo fmt --check"
run sh -c 'cd src-tauri && cargo fmt --all -- --check'

step "cargo clippy (warnings are errors)"
run sh -c 'cd src-tauri && cargo clippy --workspace --all-targets -- -D warnings'

step "cargo test (workspace)"
run sh -c 'cd src-tauri && cargo test --workspace --all-targets'

step "cargo test --doc"
run sh -c 'cd src-tauri && cargo test --workspace --doc'

if [ $INTEGRATION = 1 ]; then
  step "cargo test -- --ignored (needs an API server on :6969)"
  run sh -c 'cd src-tauri && cargo test --workspace -- --ignored'
fi

if [ $fail = 0 ]; then
  printf '\n\033[1;32m==> all checks passed\033[0m\n'
else
  printf '\n\033[1;31m==> FAILED\033[0m\n'
fi
exit $fail
