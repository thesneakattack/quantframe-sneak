{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/*": "resources/",
      "resources/sounds/*": "resources/sounds/"
    }
  },
  "productName": "Quantframe Sneak",
  "mainBinaryName": "QuantframeSneak",
  "version": "1.6.29",
  "identifier": "dev.thesneakattack.quantframe",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/thesneakattack/quantframe-sneak/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "userAgent": "Quantframe",
        "resizable": true,
        "title": "Quantframe Sneak",
        "width": 1455,
        "height": 912,
        "useHttpsScheme": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}